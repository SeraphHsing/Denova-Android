<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
<!-- AUTH-007：网络恢复后自动重连（ConnectivityManager.registerDefaultNetworkCallback）。 -->
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- P0 minimal config: cleartext HTTP is required for LAN servers (e.g. http://192.168.2.102:18081).
         G1 will refine this to a per-host network security config once the server-entry flow lands. -->
    <application
        android:name=".NovaraApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Novara"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 导出与分享（TRJ-003 / SYS-001）：只暴露 cacheDir 下的 exports 子目录，不共享外部存储。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
